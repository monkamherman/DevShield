# Copy to an operator-managed runtime.env on the VPS. Never commit runtime.env.
HARBOR_REGISTRY=harbor.example.com
HARBOR_PROJECT=devshield
HARBOR_REPOSITORY=fixture
EXPECTED_DIGEST=sha256:replace-with-64-lowercase-hex-characters
CONTAINER_NAME=devshield-app
CONTAINER_PORT=3000
HOST_PORT=3000
HEALTHCHECK_URL=http://127.0.0.1:3000/health
HEALTHCHECK_TIMEOUT=5
HEALTHCHECK_RETRIES=10
DEPLOYMENT_ENVIRONMENT=production
RUNTIME_NETWORK=
RESTART_POLICY=unless-stopped
CONTAINER_ENV_FILE=
ROLLBACK_ENABLED=1
DEVSHIELD_DEPLOYMENT_STATE_FILE=/var/lib/devshield/deployment/devshield-app.json
DEVSHIELD_DEPLOYMENT_AUTHORIZATION=/var/lib/devshield/evidence/deployment-authorization-evidence.json

