# Local Harbor only. Never commit the populated .env file.
HARBOR_VERSION=2.14.4
# Required: checksum copied from the official Harbor release asset.
HARBOR_INSTALLER_SHA256=<set-from-official-release>
HARBOR_HOSTNAME=harbor.local
HARBOR_PORT=8443
HARBOR_ADMIN_PASSWORD=<set-locally>
HARBOR_DATABASE_PASSWORD=<set-locally>
HARBOR_USERNAME=<set-locally>
HARBOR_PASSWORD=<set-locally>
HARBOR_PROJECT=devshield
HARBOR_REPOSITORY=fixture
